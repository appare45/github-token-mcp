{
    "name": "github-token-mcp",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "GitHub App installation token vending HTTP server (host-side only).",
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "dev": "tsx watch --env-file=.env src/index.ts",
        "start": "node --env-file=.env dist/index.js"
    },
    "dependencies": {
        "@1password/sdk": "^0.5.0",
        "@hono/node-server": "^2.1.1",
        "@octokit/auth-app": "^8.3.0",
        "@octokit/request-error": "^7.1.1",
        "@octokit/rest": "^22.0.1",
        "hono": "^4.13.3"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "tsx": "^4.19.0",
        "typescript": "^7.0.2"
    }
}
