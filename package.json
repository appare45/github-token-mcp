{
    "name": "github-token-mcp",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "GitHub App installation token vending MCP server (host-side only).",
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "dev": "tsx watch --env-file=.env src/index.ts",
        "start": "node --env-file=.env dist/index.js"
    },
    "dependencies": {
        "@1password/sdk": "^0.5.0",
        "@modelcontextprotocol/express": "^2.0.0",
        "@modelcontextprotocol/node": "^2.0.0",
        "@modelcontextprotocol/server": "^2.0.0",
        "@octokit/auth-app": "^8.3.0",
        "@octokit/rest": "^22.0.1",
        "express": "^5.2.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.2.0",
        "tsx": "^4.19.0",
        "typescript": "^7.0.2"
    }
}
